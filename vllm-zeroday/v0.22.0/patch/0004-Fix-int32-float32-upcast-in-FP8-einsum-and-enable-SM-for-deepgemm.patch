   "${DEEPGEMM_SUPPORT_ARCHS}" "${CUDA_ARCHS}")
diff --git a/vllm/model_executor/layers/quantization/utils/fp8_utils.py b/vllm/model_executor/layers/quantization/utils/fp8_utils.py
index 1a301420a..aa9c6ef25 100644
--- a/vllm/model_executor/layers/quantization/utils/fp8_utils.py
+++ b/vllm/model_executor/layers/quantization/utils/fp8_utils.py
@@ -1080,6 +1080,17 @@ def deepgemm_post_process_fp8_weight_block(
         r = wq.size(0) // g
         wq = wq.view(g, r, d)
         ws = ws.view(g, r // quant_block_shape[0], d // quant_block_shape[1])
+
+        # On SM120 (arch_major=12), deepgemm's fp8_einsum handles scale
+        # transformation internally via transform_sf_pair_into_required_layout.
+        # Pre-transforming here would cause a double-transformation assertion
+        # failure (sf.size(-2) mismatch after broadcast + UE8M0 packing).
+        # Return raw float32 scales and let fp8_einsum handle the layout.
+        from vllm.platforms import current_platform
+        cap = current_platform.get_device_capability()
+        if cap is not None and cap.major == 12:
+            return wq, ws
+
         # Pre-transform scale with recipe=(1, 128, 128) to broadcast + pack
         # into TMA-aligned UE8M0 (INT32) layout. At runtime fp8_einsum uses
         # recipe=(1, 1, 128) which sees INT dtype and skips re-transform.
diff --git a/vllm/model_executor/layers/sparse_attn_indexer.py b/vllm/model_executor/layers/sparse_attn_indexer.py
index 357cd852c..c2c2df777 100644
--- a/vllm/model_executor/layers/sparse_attn_indexer.py
+++ b/vllm/model_executor/layers/sparse_attn_indexer.py
@@ -83,12 +83,6 @@ def _decode_topk_logits_width(
 def _sparse_indexer_requires_deep_gemm(use_fp4_cache: bool = False) -> bool:
     if not current_platform.is_cuda():
         return False
-    if current_platform.is_device_capability_family(120):
-        # The SM120 fallback path covers FP8-Q sparse indexer calls. FP4-Q
-        # indexer calls still route through DeepGEMM's fp8_fp4 kernels, so
-        # fail during construction instead of letting the first forward hit
-        # the generic DeepGEMM missing-dependency error.
-        return use_fp4_cache
     return True
 
 
diff --git a/vllm/models/deepseek_v4/nvidia/ops/fp8_einsum.py b/vllm/models/deepseek_v4/nvidia/ops/fp8_einsum.py
index 09c0f4aa3..f9b745ed1 100644
--- a/vllm/models/deepseek_v4/nvidia/ops/fp8_einsum.py
+++ b/vllm/models/deepseek_v4/nvidia/ops/fp8_einsum.py
@@ -235,10 +235,15 @@ def deepseek_v4_fp8_einsum(
         if group_start != 0 or b_groups != num_groups:
             b = b.narrow(0, group_start, num_groups)
 
+        # Upcast packed int32 UE8M0 scales BEFORE reshaping so the block
+        # counts are computed for float32 (gran_k=128), not int32 (gran_k=512).
+        if b_scale.dtype == torch.int32:
+            from vllm.third_party.deep_gemm import unpack_ue8m0_from_int
+            b_scale = unpack_ue8m0_from_int(b_scale)
+
         if b_scale.dim() == 2:
             scale_mn = recipe[1]
-            scale_k_pack = 4 if b_scale.dtype == torch.int32 else 1
-            scale_k = recipe[2] * scale_k_pack
+            scale_k = recipe[2]
             scale_out_blocks = (out_rank + scale_mn - 1) // scale_mn
             scale_hidden_blocks = (hidden_size + scale_k - 1) // scale_k
             if b_scale.shape[0] % scale_out_blocks != 0:
@@ -266,8 +271,17 @@ def deepseek_v4_fp8_einsum(
             if b_groups != num_groups:
                 b_scale = b_scale.narrow(0, group_start, num_groups)
 
-        if _use_deepseek_v4_sm12x_triton_fp8_einsum(equation, recipe, b_scale):
+        # SM12x: use the Triton kernel directly (bypass DeepGEMM fp8_einsum
+        # which may assert on scale-layout mismatches for non-standard recipes).
+        # NOTE: Only use Triton fallback when scales are float32 (not
+        # pre-transformed to INT32 UE8M0). With the SM120 fix that skips
+        # pre-transformation for BMM, scales are always float32 here.
+        capability = current_platform.get_device_capability()
+        if capability is not None and capability.major == 12:
             deepseek_v4_sm12x_fp8_einsum(a, a_scale, b, b_scale, out)
             return
 
+    # For b.dim() == 3 (already reshaped by process_weights_after_loading),
+    # on SM12x the scale is raw float32 (not pre-transformed), so the native
+    # deepgemm-sm120 fp8_einsum handles transformation internally.
     fp8_einsum(equation, (a, a_scale), (b, b_scale), out, recipe=tuple(recipe))
diff --git a/vllm/platforms/cuda.py b/vllm/platforms/cuda.py
