 logger = init_logger(__name__)
+_index_cache_config_logged = False
+_index_cache_c4a_count = 0


+def _resolve_index_cache_skip_topk(
+    config: DeepseekV2Config | DeepseekV3Config,
+    layer_id: int,
+    *,
+    has_indexer: bool,
+    is_nextn: bool,
+) -> bool:
+    """Whether this layer should reuse top-k indices from a prior layer.
+
+    For DeepSeek-V4, C4A layers are interleaved with non-C4A layers, so
+    the skip decision is based on the C4A ordinal (how many C4A layers
+    have been seen so far), NOT the absolute layer_id.  This ensures the
+    first few C4A layers always compute to populate the shared buffer.
+    """
+    global _index_cache_config_logged, _index_cache_c4a_count
+
+    if not has_indexer or is_nextn:
+        return False
+
+    # C4A ordinal: count of indexer-bearing layers seen so far
+    c4a_idx = _index_cache_c4a_count
+    _index_cache_c4a_count += 1
+
+    index_topk_pattern = getattr(config, "index_topk_pattern", None)
+    index_topk_freq = max(1, getattr(config, "index_topk_freq", 1))
+    index_skip_topk_offset = getattr(config, "index_skip_topk_offset", 2)
+    use_index_cache = getattr(config, "use_index_cache", False)
+
+    # [IndexCache Log] 仅首次调用时打印配置摘要，启动后只一行，不影响推理。
+    # 要关闭此日志，删除下面 if 块即可。
+    if not _index_cache_config_logged:
+        _index_cache_config_logged = True
+        if use_index_cache or index_topk_freq > 1 or index_topk_pattern is not None:
+            logger.info(
+                "IndexCache enabled: use_index_cache=%s index_topk_freq=%d "
+                "index_skip_topk_offset=%d index_topk_pattern=%s",
+                use_index_cache,
+                index_topk_freq,
+                index_skip_topk_offset,
+                index_topk_pattern,
+            )
+
+    if not use_index_cache and index_topk_pattern is None and index_topk_freq == 1:
+        return False
+
+    if index_topk_pattern is None:
+        return (
+            max(c4a_idx - index_skip_topk_offset + 1, 0) % index_topk_freq != 0
+        )
+    if 0 <= c4a_idx < len(index_topk_pattern):
+        return index_topk_pattern[c4a_idx] == "S"
+    return False
+
