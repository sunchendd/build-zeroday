@@ -0,0 +1,76 @@
+# SPDX-License-Identifier: Apache-2.0
+# SPDX-FileCopyrightText: Copyright contributors to the vLLM project
+"""
+KV cache group helpers for CPU offloading with DeepSeek-V4 (DSA) models.
+
+DSAAttention layers use compressed KV (compress_ratio=1/4/128) that don't map
+to standard MLAAttentionSpec or FullAttentionSpec. We introduce lightweight
+marker subclasses so that:
+  - The metadata server can distinguish them from standard MLA and use the
+    correct memory layout (no nope/rope split).
+  - The block manager's spec_manager_map lookup finds FullAttentionManager for
+    these types (since they share the same block-level semantics).
+  - Different compress ratios stay in separate KV groups so their block IDs
+    are managed independently.
+"""
+from dataclasses import dataclass
+
+from vllm.v1.kv_cache_interface import KVCacheSpec, MLAAttentionSpec
+
+
+@dataclass(frozen=True)
+class DSACompress1LikeSpec(MLAAttentionSpec):
+    """Marker spec for DSAAttention layers with compress_ratio=1 (SWA-only)."""
+    pass
+
+
+@dataclass(frozen=True)
+class DSACompress4LikeSpec(MLAAttentionSpec):
+    """Marker spec for DSAAttention layers with compress_ratio=4."""
+    pass
+
+
+@dataclass(frozen=True)
+class DSACompress128LikeSpec(MLAAttentionSpec):
+    """Marker spec for DSAAttention layers with compress_ratio=128."""
+    pass
+
+
+def build_kv_cache_groups(
+    kv_cache_specs: dict[str, KVCacheSpec],
+) -> tuple[tuple[KVCacheSpec, ...], dict[str, int]]:
+    """Group layers by identical spec type+value into KV cache groups.
+
+    Returns:
+        group_specs: tuple of unique specs (one per group)
+        layer_to_group_id: mapping layer_name -> group index
+    """
+    group_specs: list[KVCacheSpec] = []
+    layer_to_group_id: dict[str, int] = {}
+    for layer_name, spec in kv_cache_specs.items():
+        for group_id, existing_spec in enumerate(group_specs):
+            if type(existing_spec) is type(spec) and existing_spec == spec:
+                layer_to_group_id[layer_name] = group_id
+                break
+        else:
+            layer_to_group_id[layer_name] = len(group_specs)
+            group_specs.append(spec)
+    return tuple(group_specs), layer_to_group_id
+
+
+def empty_block_ids(num_groups: int) -> tuple[list[int], ...]:
+    """Return a tuple of empty block-ID lists, one per group."""
+    return tuple([] for _ in range(num_groups))
+
+
+def clone_block_ids(
+    block_ids: tuple[list[int], ...] | None,
+    num_groups: int,
+) -> tuple[list[int], ...]:
+    """Clone block_ids, padding or truncating to num_groups."""
+    if block_ids is None:
+        return empty_block_ids(num_groups)
+    cloned = tuple(list(group_ids) for group_ids in block_ids[:num_groups])
+    if len(cloned) < num_groups:
+        cloned += tuple([] for _ in range(num_groups - len(cloned)))
+    return cloned
